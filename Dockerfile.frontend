# 前端形态镜像 — 不安装 Chromium / yt-dlp / ffmpeg / python3。
# 少量共用 JS 依赖仍保留，实际 Node 运行包体积见 runtime-manifest.json。
#
# 构建:docker build -f Dockerfile.frontend -t shibei-frontend .
# 运行:docker compose -f docker-compose.frontend.yml up -d

FROM node:22-bookworm-slim AS base
WORKDIR /app
# Optional download mirror for restricted build networks; unset keeps Prisma defaults.
ARG PRISMA_ENGINES_MIRROR
ARG NPM_CONFIG_REGISTRY
ENV NEXT_TELEMETRY_DISABLED=1
ENV APP_MODE=frontend
# Prisma needs OpenSSL available while generating the client so it selects the
# Debian OpenSSL 3 query engine instead of falling back to openssl-1.1.x.
# Optional signed Debian mirrors. Defaults retain the upstream sources.
ARG APT_MIRROR
ARG APT_SECURITY_MIRROR
RUN if [ -n "$APT_MIRROR" ]; then sed -i "s|http://deb.debian.org/debian$|$APT_MIRROR|" /etc/apt/sources.list.d/debian.sources; fi \
 && if [ -n "$APT_SECURITY_MIRROR" ]; then sed -i "s|http://deb.debian.org/debian-security$|$APT_SECURITY_MIRROR|" /etc/apt/sources.list.d/debian.sources; fi \
 && apt-get update && apt-get install -y --no-install-recommends \
      openssl \
    && rm -rf /var/lib/apt/lists/*

FROM base AS deps
COPY package.json package-lock.json* ./
# 跳过 Playwright 的 postinstall 浏览器下载,前端模式不需要
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
RUN npm ci --no-audit --no-fund

FROM deps AS builder
COPY . .
RUN npx prisma generate
RUN npm run build
# Produce the same platform-specific runtime directory as bare-metal releases.
# Compiler caches, dev packages, unused native targets and source maps never
# enter the runner layer; the original build workspace remains disposable.
RUN npm prune --omit=dev --no-audit --no-fund \
 && npx prisma generate \
 && node scripts/package-runtime.mjs --out /runtime --reuse-installed

FROM base AS runner
ARG GIT_COMMIT=unknown
ARG BUILD_TIME=unknown
ENV NODE_ENV=production
ENV APP_MODE=frontend
ENV BUILD_COMMIT=$GIT_COMMIT
ENV BUILD_TIME=$BUILD_TIME
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
ENV NODE_OPTIONS="--max-old-space-size=192"
ENV UV_THREADPOOL_SIZE=2
ENV MALLOC_ARENA_MAX=2
# 仅装 ca-certificates(HTTPS 拉 backend 用)。不装 fonts-noto-cjk(~90MB)：
# 前端形态没有 chromium/截图/服务端文字渲染，中文显示全靠网页字体。
# Optional signed Debian mirrors. Defaults retain the upstream sources.
ARG APT_MIRROR
ARG APT_SECURITY_MIRROR
RUN if [ -n "$APT_MIRROR" ]; then sed -i "s|http://deb.debian.org/debian$|$APT_MIRROR|" /etc/apt/sources.list.d/debian.sources; fi \
 && if [ -n "$APT_SECURITY_MIRROR" ]; then sed -i "s|http://deb.debian.org/debian-security$|$APT_SECURITY_MIRROR|" /etc/apt/sources.list.d/debian.sources; fi \
 && apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /runtime/node_modules ./node_modules
COPY --from=builder /runtime/.next ./.next
COPY --from=builder /runtime/public ./public
COPY --from=builder /runtime/package.json ./package.json
COPY --from=builder /runtime/package-lock.json ./package-lock.json
COPY --from=builder /runtime/prisma ./prisma
COPY --from=builder /runtime/src ./src
COPY --from=builder /runtime/scripts ./scripts
COPY --from=builder /runtime/next.config.mjs ./next.config.mjs
COPY --from=builder /runtime/tsconfig.json ./tsconfig.json
COPY --from=builder /runtime/runtime-manifest.json ./runtime-manifest.json
EXPOSE 3000
CMD ["sh", "scripts/start-app.sh"]
